<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.spendwise</groupId>
    <artifactId>spendwise-parent</artifactId>
    <version>1.2.4</version>
    <packaging>pom</packaging>
    <name>SpendWise :: Parent</name>
    <description>Parent POM and BOM for every SpendWise service repository, plus the shared
        libraries spendwise-common, spendwise-events and spendwise-grpc-contracts. Released as one version and
        published to GitHub Packages; each service repo pins the release it uses.</description>

    <scm>
        <url>https://github.com/PrathameshMax/spendwise-shared</url>
        <connection>scm:git:https://github.com/PrathameshMax/spendwise-shared.git</connection>
    </scm>

    <!-- Polyrepo — the target of `mvn deploy` (release workflow). The id "github"
         must match the <server> id in settings.xml that holds the token. -->
    <distributionManagement>
        <repository>
            <id>github</id>
            <name>GitHub Packages</name>
            <url>https://maven.pkg.github.com/PrathameshMax/spendwise-shared</url>
        </repository>
    </distributionManagement>

    <!-- Polyrepo — only the shared libraries are built here. Modules are not
         inherited, so service repos that use this POM as parent are unaffected. -->
    <modules>
        <module>spendwise-common</module>
        <module>spendwise-events</module>
        <module>spendwise-grpc-contracts</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <spring-boot.version>3.5.16</spring-boot.version>
        <spring-cloud.version>2025.0.3</spring-cloud.version>
        <!-- Polyrepo — explicit, not ${project.version}: in a service that inherits
             this POM, ${project.version} would be the service's own version. -->
        <spendwise-common.version>1.2.3</spendwise-common.version>
        <!-- Not part of spring-boot-dependencies' BOM, so pinned explicitly here (Milestone 7) -->
        <springdoc-openapi.version>2.10.0</springdoc-openapi.version>
        <!-- Not part of spring-boot-dependencies' BOM either, so pinned explicitly here
             (Milestone 8) — used for compile-time-checked entity-to-response-DTO mapping. -->
        <mapstruct.version>1.6.3</mapstruct.version>
        <!-- Not part of spring-boot-dependencies' or spring-cloud-dependencies' BOM, so
             pinned explicitly here (Milestone 10/11) — the Retry (Milestone 10 timeouts'
             companion) and, from Milestone 12 onward, CircuitBreaker/Bulkhead/TimeLimiter
             primitives layered directly over the Feign clients declared in
             transaction-service and budget-service. -->
        <resilience4j.version>2.4.0</resilience4j.version>
        <!-- Not part of spring-boot-dependencies' or spring-cloud-dependencies' BOM, so
             pinned explicitly here (Milestone 15) — this exact 1.68.1/3.25.5/0.6.1 trio
             is the maintainer-chosen, self-consistent combination grpc-java's own
             official examples module pins (confirmed against
             https://github.com/grpc/grpc-java/blob/v1.68.1/examples/pom.xml), not an
             independently-guessed set of versions: grpc-java and protobuf-java ship on
             separate release cadences, and an uncoordinated pairing is a common source
             of runtime/codegen mismatches this platform has no way to detect before a
             real `mvn compile` runs (no Maven Central access in the build sandbox this
             milestone was authored in — see budget-service/analytics-service pom.xml
             comments for what that does and does not mean for validation). -->
        <grpc.version>1.85.1</grpc.version>
        <protobuf.version>3.25.5</protobuf.version>
        <protobuf-maven-plugin.version>0.6.1</protobuf-maven-plugin.version>
        <os-maven-plugin.version>1.7.1</os-maven-plugin.version>
        <!-- net.devh's starter is a thin autoconfiguration layer (the @GrpcService/
             @GrpcClient annotations and the server/channel lifecycle beans) that does not
             publish its own BOM; grpc-bom above is what actually pins every io.grpc:*
             artifact's version platform-wide, same role spring-boot-dependencies/
             spring-cloud-dependencies play for everything else in this table. Latest
             stable per Maven Central as of this milestone. -->
        <grpc-spring-boot-starter.version>3.1.0.RELEASE</grpc-spring-boot-starter.version>
        <!-- Milestone 17 fix — Maven's super-POM default plugin versions are not
             managed by the imported Boot BOM (a BOM import manages dependencies,
             not plugins), so these two are pinned explicitly for the Mockito
             agent configuration in the mockito-agent profile below. -->
        <maven-surefire-plugin.version>3.6.1</maven-surefire-plugin.version>
        <maven-dependency-plugin.version>3.11.0</maven-dependency-plugin.version>
        <!-- Empty default so surefire's late-bound @{argLine} below always
             resolves; a plugin that sets argLine itself (e.g. a JaCoCo agent,
             if one is added later) is appended to, not overwritten. -->
        <argLine></argLine>
        <!-- Milestone 22 — Avro contracts and the Confluent Schema Registry serdes.
             Neither is in the Boot or Cloud BOM. Confluent Platform 7.9.x is the
             line built on Apache Kafka 3.9 (the brokers' version); 7.9.8 is both
             the serializer version here and the cp-schema-registry image tag in
             docker-compose.yml, so client and server are one release. avro 1.11.5
             is the version Confluent 7.9.8 itself builds against (confluentinc/
             common v7.9.8 pom.xml, avro.version), and avro-maven-plugin must
             match the avro runtime that reads the classes it generates.
             kafka-avro-serializer declares Kafka itself as "provided", so the
             kafka-clients version stays the one Spring Boot manages. -->
        <spendwise-events.version>1.2.3</spendwise-events.version>
        <!-- Phase 6 — the gRPC contract (budget_summary.proto) and its generated stubs,
             compiled once here instead of from two hand-synchronised copies in
             budget-service (server) and analytics-service (client). -->
        <spendwise-grpc-contracts.version>1.2.3</spendwise-grpc-contracts.version>
        <confluent.version>7.9.11</confluent.version>
        <avro.version>1.11.5</avro.version>
    </properties>

    <!-- Milestone 22 — Confluent's serializers are published to Confluent's own
         Maven repository, not to Maven Central. Declared once here; every other
         artifact still resolves from Central first. -->
    <repositories>
        <repository>
            <id>confluent</id>
            <name>Confluent</name>
            <url>https://packages.confluent.io/maven/</url>
        </repository>
    </repositories>

    <dependencyManagement>
        <dependencies>

            <!-- First on purpose: overrides the Testcontainers version Spring Boot pins.
          1.21.4 talks Docker API 1.44+, which Docker 29 requires. -->
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>1.21.4</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Before spring-boot-dependencies on purpose: first BOM wins. Spring Boot
     3.5.16 pins Jackson 2.21.4; 2.21.7 fixes CVE-2026-89407, CVE-2026-89425,
     CVE-2026-68497, CVE-2026-91776, CVE-2026-91777. -->
            <dependency>
                <groupId>com.fasterxml.jackson</groupId>
                <artifactId>jackson-bom</artifactId>
                <version>2.23.0</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- CVE-2026-102554 (DoS). Pulled in by gRPC as 33.2.1-android; the -jre
     flavour is the server-side build of the same release. -->
            <dependency>
                <groupId>com.google.guava</groupId>
                <artifactId>guava</artifactId>
                <version>33.8.0-jre</version>
            </dependency>
            <!-- CVE-2026-106451 (code execution via temp files). Pulled in by kafka-clients. -->
            <dependency>
                <groupId>at.yawk.lz4</groupId>
                <artifactId>lz4-java</artifactId>
                <version>1.14.1</version>
            </dependency>

            <!-- CVE-2026-108106, CVE-2026-93451: fixed in 1.1.10.9, pulled in by kafka-clients -->
            <dependency>
                <groupId>org.xerial.snappy</groupId>
                <artifactId>snappy-java</artifactId>
                <version>1.1.10.12</version>
            </dependency>

            <!-- Overrides of versions spring-boot-dependencies 3.5.16 pins, declared
     before it on purpose (first declaration wins; an imported BOM's properties
     such as tomcat.version cannot be overridden from here). Drop each entry once
     spring-boot.version manages the same or a newer version. -->

            <!-- Tomcat 10.1.55: CVE-2026-55276, CVE-2026-65182, CVE-2026-65637,
     CVE-2026-65905, CVE-2026-68525 (CRITICAL), CVE-2026-53404 (HIGH).
     10.1.59 is the lowest release that fixes all six. -->
            <dependency>
                <groupId>org.apache.tomcat.embed</groupId>
                <artifactId>tomcat-embed-core</artifactId>
                <version>10.1.62</version>
            </dependency>
            <dependency>
                <groupId>org.apache.tomcat.embed</groupId>
                <artifactId>tomcat-embed-el</artifactId>
                <version>10.1.62</version>
            </dependency>
            <dependency>
                <groupId>org.apache.tomcat.embed</groupId>
                <artifactId>tomcat-embed-websocket</artifactId>
                <version>10.1.62</version>
            </dependency>

            <!-- HttpCore 5.3.6: CVE-2026-54399, CVE-2026-54428 (HIGH, DoS via headers).
     Pulled in by httpclient5; 5.4.x keeps the 5.x API (minor release). -->
            <dependency>
                <groupId>org.apache.httpcomponents.core5</groupId>
                <artifactId>httpcore5</artifactId>
                <version>5.5</version>
            </dependency>
            <dependency>
                <groupId>org.apache.httpcomponents.core5</groupId>
                <artifactId>httpcore5-h2</artifactId>
                <version>5.5</version>
            </dependency>
            <dependency>
                <groupId>org.apache.httpcomponents.core5</groupId>
                <artifactId>httpcore5-reactive</artifactId>
                <version>5.5</version>
            </dependency>

            <!-- Bouncy Castle 1.80.x: CVE-2026-8763 (CRITICAL), CVE-2026-13506 (HIGH).
     Transitive, not in the Boot BOM. The three jars must stay on one version. -->
            <dependency>
                <groupId>org.bouncycastle</groupId>
                <artifactId>bcprov-jdk18on</artifactId>
                <version>1.87</version>
            </dependency>
            <dependency>
                <groupId>org.bouncycastle</groupId>
                <artifactId>bcpkix-jdk18on</artifactId>
                <version>1.87</version>
            </dependency>
            <dependency>
                <groupId>org.bouncycastle</groupId>
                <artifactId>bcutil-jdk18on</artifactId>
                <version>1.87</version>
            </dependency>

            <!-- Netty 4.1.135.Final: CVE-2026-59901, CVE-2026-55831, CVE-2026-55833,
     CVE-2026-56745, CVE-2026-56819 (HIGH), CVE-2026-75595 (CRITICAL).
     4.1.137.Final fixes all six; a BOM so every netty-* module moves together
     (Reactor Netty / WebClient / Spring Cloud Gateway). grpc-netty-shaded is
     unaffected: it carries its own relocated copy. -->
            <dependency>
                <groupId>io.netty</groupId>
                <artifactId>netty-bom</artifactId>
                <version>4.2.21.Final</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- FreeMarker 2.3.34: CVE-2026-84939 (CRITICAL, path traversal via locale).
     Pulled in by the Eureka server dashboard. -->
            <dependency>
                <groupId>org.freemarker</groupId>
                <artifactId>freemarker</artifactId>
                <version>2.3.35</version>
            </dependency>

            <!-- pgjdbc 42.7.11: CVE-2026-54291 (HIGH, SCRAM-SHA-256-PLUS downgrade). -->
            <dependency>
                <groupId>org.postgresql</groupId>
                <artifactId>postgresql</artifactId>
                <version>42.7.14</version>
            </dependency>

            <!-- Resilience4j as a BOM, before spring-boot-dependencies and
     spring-cloud-dependencies on purpose. Pinning only resilience4j-spring-boot3
     left its transitive modules (resilience4j-spring6, -circuitbreaker, ...) on
     the older version Spring Cloud's BOM manages; spring-boot3 2.4.0 against
     spring6 from an older release fails at startup with NoClassDefFoundError
     io/github/resilience4j/spring6/fallback/RxJava3FallbackDecorator. -->
            <dependency>
                <groupId>io.github.resilience4j</groupId>
                <artifactId>resilience4j-bom</artifactId>
                <version>${resilience4j.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.spendwise</groupId>
                <artifactId>spendwise-common</artifactId>
                <version>${spendwise-common.version}</version>
            </dependency>
            <dependency>
                <groupId>com.spendwise</groupId>
                <artifactId>spendwise-events</artifactId>
                <version>${spendwise-events.version}</version>
            </dependency>
            <dependency>
                <groupId>com.spendwise</groupId>
                <artifactId>spendwise-grpc-contracts</artifactId>
                <version>${spendwise-grpc-contracts.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.avro</groupId>
                <artifactId>avro</artifactId>
                <version>${avro.version}</version>
            </dependency>
            <dependency>
                <groupId>io.confluent</groupId>
                <artifactId>kafka-avro-serializer</artifactId>
                <version>${confluent.version}</version>
                <exclusions>
                    <!-- Confluent's schema-registry client brings the javax build of the
                         swagger annotations (io.swagger.core.v3:swagger-annotations). springdoc
                         uses the jakarta build (swagger-annotations-jakarta): different artifactId,
                         same classes, so both land on the classpath and the older Parameter
                         class wins, breaking /v3/api-docs with NoSuchMethodError
                         (Parameter.validationGroups). The client only uses them as annotations on
                         its REST entity classes, which the JVM ignores when the class is absent. -->
                    <exclusion>
                        <groupId>io.swagger.core.v3</groupId>
                        <artifactId>swagger-annotations</artifactId>
                    </exclusion>
                </exclusions>
            </dependency>
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc-openapi.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webflux-ui</artifactId>
                <version>${springdoc-openapi.version}</version>
            </dependency>
            <dependency>
                <groupId>org.mapstruct</groupId>
                <artifactId>mapstruct</artifactId>
                <version>${mapstruct.version}</version>
            </dependency>
            <dependency>
                <groupId>org.mapstruct</groupId>
                <artifactId>mapstruct-processor</artifactId>
                <version>${mapstruct.version}</version>
            </dependency>
            <!-- Milestone 15 — imported (not just a single artifact version pinned) because
                 grpc-protobuf/grpc-stub/grpc-services/grpc-netty-shaded must all resolve to
                 the SAME grpc-java release in both budget-service (gRPC server) and
                 analytics-service (gRPC client); importing the BOM once here guarantees
                 that platform-wide the same way spring-cloud-dependencies already does for
                 every spring-cloud-starter-* artifact above. -->
            <dependency>
                <groupId>io.grpc</groupId>
                <artifactId>grpc-bom</artifactId>
                <version>${grpc.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.16.0</version>
                    <configuration>
                        <parameters>true</parameters>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                    <executions>
                        <execution>
                            <id>repackage</id>
                            <goals>
                                <goal>repackage</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${maven-surefire-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-dependency-plugin</artifactId>
                    <version>${maven-dependency-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.avro</groupId>
                    <artifactId>avro-maven-plugin</artifactId>
                    <version>${avro.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <profiles>
        <!-- Milestone 17 fix — load Mockito's inline mock maker as a -javaagent
             instead of letting it self-attach at runtime. Mockito 5 (via
             spring-boot-starter-test) attaches its byte-buddy agent dynamically
             on first use, which JDK 21 now warns about ("Mockito is currently
             self-attaching to enable the inline-mock-maker... dynamic loading of
             agents will be disallowed by default in a future release", JEP 451).
             Mockito's documented fix: maven-dependency-plugin's `properties` goal
             exposes every dependency's local jar path as a property named
             groupId:artifactId:type, and surefire passes mockito-core's as
             -javaagent. @{argLine} (late-bound, not ${argLine}) keeps anything
             another plugin already put in argLine.

             A profile, activated only for modules that have a src/test/java
             directory, rather than a plain parent-level plugin: spendwise-common
             has no tests and no mockito-core dependency, so
             ${org.mockito:mockito-core:jar} would stay an unresolved literal
             there and the forked test JVM would fail to start on it. -->
        <profile>
            <id>mockito-agent</id>
            <activation>
                <file>
                    <exists>${basedir}/src/test/java</exists>
                </file>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-dependency-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>resolve-mockito-agent-path</id>
                                <goals>
                                    <goal>properties</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <argLine>@{argLine} -javaagent:${org.mockito:mockito-core:jar} -Xshare:off</argLine>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
